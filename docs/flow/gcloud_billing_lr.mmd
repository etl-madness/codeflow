    subgraph lane_pipeline_gcloud_billing_preflight ["Pipeline Preflight (gcloud_billing)"]
        s1[("<b>preflight_check</b><br/><small>SQL Query</small><br/><sub>Preflight check for GCP billing data</sub>")]:::dbNode
        s2[("<b>preflight_check_2</b><br/><small>SQL Query</small><br/><sub>Another preflight check for GCP billing data</sub>")]:::dbNode
        s3["<b>database_check</b><br/><small>Assertion</small><br/><sub>Check database connectivity</sub>"]:::assertNode
        s4["<b>user_check</b><br/><small>Assertion</small><br/><sub>Check connected user is dbo</sub>"]:::assertNode
    end

    subgraph lane_pipeline_gcloud_billing_flow ["Pipeline Flow (gcloud_billing)"]
        s5["<b>ExtractData</b><br/><small>Script</small><br/><sub>Extract GCP billing data from BigQuery</sub>"]:::scriptNode
        s6[("<b>LoadData</b><br/><small>SQL Query</small><br/><sub>Load Google Cloud billing JSON data into SQL Server table using OPENJSON</sub>")]:::dbNode
    end

    subgraph lane_db_database1 ["Database (database1)"]
        s7[("<b>dbo.GcpBillingExport</b><br/><small>Database Table</small><br/><sub>Table dbo.GcpBillingExport in database1</sub>")]:::dbNode
